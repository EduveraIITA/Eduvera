{
  "name": "Edura OS",
  "short_name": "Edura",
  "description": "School attendance, timetable, leave, and diary workspace for students and families.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f8f9ff",
  "theme_color": "#f8f9ff",
  "icons": [
    {
      "src": "/edura-leaf-favicon.png",
      "sizes": "64x64",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/edura-leaf-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/edura-leaf-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
