{
  "name": "omnischool-node-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented NestJS/Fastify backend for OmniSchool",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build --silent && vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --import tsx src/database/migrate.ts",
    "db:generate": "python3 scripts/generate_school_data.py",
    "db:seed": "python3 scripts/generate_school_data.py --load && npm run db:seed:roles",
    "db:seed:roles": "DEMO_MODE=true node --import tsx src/database/seed-roles.ts",
    "test:seed": "python3 -m unittest discover -s scripts -p 'test_*.py' -v"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "fastify": "5.12.3",
    "kysely": "^0.28.7",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "5.12.3"
    }
  }
}
