NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
# One PostgreSQL17 server; each application has its own database.
DATABASE_URL=postgresql://localhost:5432/thatcampus_live
# Required by db:migrate. Use direct PostgreSQL (preferred) or session pooling, never transaction pooling.
MIGRATION_DATABASE_URL=postgresql://localhost:5432/thatcampus_live
DATABASE_POOL_MAX=10
# Milliseconds; applies to application queries, not schema migrations.
DATABASE_QUERY_TIMEOUT_MS=60000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
# Shared isolated Simulation store, provisioned separately from Live. Never use
# the Live URL here. Requires pg_dump in the backend runtime for frozen captures.
# All runs share this database and bounded pools; no database/process per run.
CAMPUS_SIMULATION_DATABASE_URL=postgresql://localhost:5432/thatcampus_simulation
# Optional absolute executable; otherwise pg_dump must be on the API process PATH,
# including launchd/container services (not just the interactive terminal PATH).
# The client must be PostgreSQL17+ and not older than the source server's major.
# SIMULATION_PG_DUMP_PATH=/opt/homebrew/opt/postgresql@17/bin/pg_dump
# Product Simulation control-plane budgets. Active or paused runs never receive
# a wall-clock TTL; pressure rejects admission or pauses work without deleting it.
SIMULATION_MAX_WORLDS_PER_INSTITUTION=12
SIMULATION_MAX_RUNNING_RUNS_PER_INSTITUTION=4
SIMULATION_MAX_LEASES_PER_INSTITUTION=4
SIMULATION_MAX_STORAGE_BYTES_PER_INSTITUTION=2147483648
SIMULATION_RUN_STORAGE_RESERVATION_BYTES=104857600
SIMULATION_MAX_PINNED_RUNS_PER_INSTITUTION=4
SIMULATION_TERMINAL_RETENTION_DAYS=30
# A crashed capture becomes failed after this DB-clock age; its target data is
# retained until the ordinary fenced GC policy removes the exact run lineage.
SIMULATION_PREPARATION_TIMEOUT_MS=900000
SIMULATION_WORKER_INTERVAL_MS=1000
SIMULATION_WORKER_MAX_RUNS_PER_POLL=4
SIMULATION_WORKER_LEASE_SECONDS=60
# Enable only after the deployment's world adapter supports fenced, reference-safe GC.
SIMULATION_GC_ENABLED=false
SIMULATION_GC_INTERVAL_MS=60000
SIMULATION_GC_BATCH_SIZE=4
SIMULATION_GC_LEASE_SECONDS=120
# Required in managed stage/production. LISTEN needs direct or session pooling, never transaction pooling.
EVENT_DATABASE_URL=postgresql://localhost:5432/thatcampus_live
EVENT_BROKER_CONNECT_TIMEOUT_MS=5000
EVENT_WORKER_INTERVAL_MS=500
AGENT_CHANNEL_WORKER_INTERVAL_MS=1000
AGENT_CHANNEL_LINK_TTL_MINUTES=15
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Optional: when omitted, the server resolves the username with Telegram getMe.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTO_REGISTER_WEBHOOK=false
EVENT_BATCH_SIZE=100
EVENT_CLEANUP_BATCH_SIZE=1000
EVENT_REPLAY_LIMIT=250
SSE_MAX_CONNECTIONS=10000
SSE_MAX_CONNECTIONS_PER_SESSION=1
SESSION_COOKIE_NAME=omnischool_session
SESSION_TTL_SECONDS=28800
COOKIE_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
TRUST_PROXY=true
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
DEMO_MODE=true
DEMO_PROFILE_SWITCHER_ENABLED=false
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_SESSION_TTL_SECONDS=1800
PUBLIC_DEMO_MAX_STARTS_PER_HOUR=20
DEMO_PASSWORD=OmniDemo@2026
RELEASE_SHA=local-development
# Required in managed stage/production; omit locally unless scraping /metrics with authentication.
# METRICS_TOKEN=generate-a-unique-random-value-of-at-least-32-characters
SPA_DIST_DIR=../frontend/dist
UPLOAD_DIR=./storage/leave-documents
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=30000
PHOTO_ATTENDANCE_ENABLED=false
PHOTO_ATTENDANCE_BASE_URL=http://127.0.0.1:8100/api
PHOTO_ATTENDANCE_API_TOKEN=
PHOTO_ATTENDANCE_TIMEOUT_MS=120000
# Reviewed cross-app agent (separate from the legacy attendance copilot above).
# Local by default; no automatic cloud fallback or model download.
AGENT_PROVIDER=ollama
AGENT_MODEL=qwen3:8b
AGENT_BASE_URL=http://127.0.0.1:11434
# Optional verified model-context override (4096-4000000). Conversation memory
# compacts with the configured LLM after stored turns exceed 30% of this value.
# AGENT_CONTEXT_WINDOW_TOKENS=16384
# Bounded, inspectable long-term personalization. School facts never belong here.
AGENT_MEMORY_TOKEN_BUDGET=1200
AGENT_MEMORY_MAX_ITEMS=32
AGENT_MEMORY_ITEM_TOKEN_LIMIT=96
AGENT_MEMORY_TTL_DAYS=365
# Cloud alternatives: openai, anthropic, gemini, openai-compatible.
# Set an explicit model and matching HTTPS base URL when changing provider.
# AGENT_API_KEY=configure-in-your-server-secret-store

# Virtual campus: deliberate OpenStreetMap lookup, or manual/GeoJSON import.
CAMPUS_MAP_IMPORT_ENABLED=true
# Development endpoint; production must explicitly configure its reviewed provider.
CAMPUS_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
# Image analysis uses the same approved Vertex configuration and shared allowance
# as the Assistant. Without it, uploaded plans remain available for tracing.
# See docs/blueprint/SCHOOL_AGENT.md for provider setup and release gates.

# Optional local vision-language model for photo attendance. Keep this separate
# from OLLAMA_MODEL, which is used by the text attendance copilot.
PHOTO_ATTENDANCE_OLLAMA_URL=http://127.0.0.1:11434
PHOTO_ATTENDANCE_OLLAMA_MODEL=qwen3-vl:4b-instruct
LOG_LEVEL=info
# postgres = buckets shared across API instances; memory = no DB round trip per request.
# Defaults to memory in development, postgres everywhere else (tests reset the shared table).
#RATE_LIMIT_STORE=postgres

# Invitation email: configure on the server; never commit real credentials.
INVITATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER=projectpathyakram@gmail.com
# SMTP_PASSWORD=<new Google app password>
# PUBLIC_URL=https://omnischool-stage.up.railway.app

# Razorpay SANDBOX ONLY; never put the secret in frontend variables or source.
# Enable only outside production with test credentials. DEMO_MODE stays false.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Independent secret chosen when configuring the Razorpay dashboard webhook.
RAZORPAY_WEBHOOK_SECRET=
