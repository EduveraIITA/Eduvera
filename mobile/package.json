{
  "name": "thatcampus-mobile",
  "description": "ThatCampus universal React Native application for web, Android, iPhone and iPad",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-print"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "phosphor-react-native": "^3.0.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-razorpay": "3.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-skia": "2.15.2",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "~19.3.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "26.1.0",
    "jsqr": "1.4.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-campus-skia-web.cjs",
    "start": "expo start --dev-client",
    "ios": "node scripts/ios-simulator.mjs",
    "android": "expo run:android",
    "android:build": "node scripts/android-build.mjs",
    "android:preview": "node scripts/android-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "ios:prepare": "node scripts/ios-simulator.mjs --prepare --prepare-only",
    "ios:build": "node scripts/ios-simulator.mjs --build-only",
    "web:prepare": "node scripts/prepare-campus-skia-web.cjs",
    "web": "expo start --web --localhost",
    "export:web": "npm run web:prepare && expo export --platform web"
  },
  "private": true
}
